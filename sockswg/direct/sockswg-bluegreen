#!/usr/bin/env bash

set -euo pipefail

BASE_DIR=${BASE_DIR:-/etc/sockswg-bluegreen}
STATE_DIR=${STATE_DIR:-/run/sockswg-bluegreen}
ACCOUNT_B=$BASE_DIR/account-b.json
ACCOUNT_A=$BASE_DIR/account-a.json
PRIVATE_KEY_B=$BASE_DIR/private-b.key
SOCKD_B=$BASE_DIR/sockd-b.conf
API_SCRIPT=${API_SCRIPT:-/usr/local/lib/warp-selfheal/api.sh}
ACTIVE_FILE=$BASE_DIR/active
SETTINGS_FILE=${SETTINGS_FILE:-/etc/default/sockswg-bluegreen}

NS_B=sockswg-b
VETH_HOST=swgb-host
VETH_NS=swgb-ns
HOST_ADDR=10.203.2.1/30
HOST_IP=10.203.2.1
NS_ADDR=10.203.2.2/30
NS_IP=10.203.2.2
WARP4=172.16.0.2/32
TABLE_B=51822
FRONT_PORT=40000
BACKEND_B_PORT=40002
CHECK_USER=sockswg-bgcheck
SELECTOR_COMMENT=sockswg-bluegreen-b
WARP_PEER_KEY='bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo='
WARP_ENDPOINT='162.159.192.1:2408'
ENDPOINT_B_FILE=$BASE_DIR/endpoint-b
ENDPOINT_CANDIDATES='162.159.192.1:2408 162.159.192.1:4500 162.159.192.1:1701 162.159.192.1:500 162.159.192.6:2408 162.159.192.1:2408'

DESIRED_LOC=JP
FAIL_THRESHOLD=2
ROTATE_INTERVAL=3600
CANDIDATE_FAIL_THRESHOLD=3
DRAIN_MIN_SECONDS=120
DRAIN_CONNECTION_THRESHOLD=20
GEMINI_CHECK_INTERVAL=3600
GEMINI_TIMEOUT=30
GEMINI_URL='https://gemini.google.com/_/BardChatUi/data/assistant.lamda.BardFrontendService/StreamGenerate'
[ -r "$SETTINGS_FILE" ] && . "$SETTINGS_FILE"

proxy_backend() {
  die 'legacy SOCKS installer disabled on this direct-WARP pilot; use the managed direct service'
}

log() {
  printf 'sockswg-bluegreen: %s\n' "$*"
  logger -t sockswg-bluegreen -- "$*" 2>/dev/null || true
}

die() {
  log "$*" >&2
  exit 1
}

require_root() {
  [ "$(id -u)" = 0 ] || die 'must be run as root'
}

account_value() {
  local key=$1
  local file=${2:-$ACCOUNT_B}
  awk -F '"' -v key="$key" '$2 == key {print $4; exit}' "$file"
}

register_account() {
  local file=$1
  [ -x "$API_SCRIPT" ] || die "registration helper is missing: $API_SCRIPT"
  "$API_SCRIPT" --file "$file" --register >/dev/null
  chmod 600 "$file"
}

cancel_account() {
  local file=$1
  [ -s "$file" ] || return 0
  "$API_SCRIPT" --file "$file" --cancle >/dev/null 2>&1 || \
    log "warning: could not unregister retired peer recorded in $file"
}

ensure_account_b() {
  [ -s "$ACCOUNT_B" ] && return 0
  [ -x "$API_SCRIPT" ] || die "registration helper is missing: $API_SCRIPT"
  log 'registering an independent WARP peer for slot B'
  register_account "$ACCOUNT_B"
}

write_b_config() {
  local account=${1:-$ACCOUNT_B} private_key
  private_key=$(account_value private_key "$account")
  [ -n "$private_key" ] || die 'slot B WARP private key is missing'
  printf '%s\n' "$private_key" > "$PRIVATE_KEY_B"
  chmod 600 "$PRIVATE_KEY_B"
}

write_a_config() {
  local account=$1 private_key
  private_key=$(account_value private_key "$account")
  [ -n "$private_key" ] || die 'candidate A private key is missing'
  {
    printf '[Interface]\nPrivateKey = %s\n' "$private_key"
    printf 'Address = 172.16.0.2/32\nMTU = 1420\nTable = 51821\n'
    printf 'PostUp = ip -4 rule add priority 10020 from 172.16.0.2/32 lookup 51821\n'
    printf 'PostDown = ip -4 rule del priority 10020 from 172.16.0.2/32 lookup 51821\n'
    printf '\n[Peer]\nPublicKey = %s\nAllowedIPs = 0.0.0.0/0\nEndpoint = %s\nPersistentKeepalive = 30\n' "$WARP_PEER_KEY" "$WARP_ENDPOINT"
  } > /etc/wireguard/sockswg.conf
  chmod 600 /etc/wireguard/sockswg.conf
}

prefer_host_ipv4() {
  local file=/etc/gai.conf
  [ -e "$file" ] || : > "$file"
  if grep -Eq '^[#[:space:]]*precedence[[:space:]]+::ffff:0:0/96[[:space:]]+100[[:space:]]*$' "$file"; then
    sed -i -E 's|^[#[:space:]]*precedence[[:space:]]+::ffff:0:0/96[[:space:]]+100[[:space:]]*$|precedence ::ffff:0:0/96  100|' "$file"
  else
    printf '\nprecedence ::ffff:0:0/96  100\n' >> "$file"
  fi
}

normalize_a_ipv4_only() {
  die 'legacy SOCKS installer disabled on this direct-WARP pilot; use the managed direct service'
}

restart_a() {
  systemctl stop warp-sockswg-watchdog.timer >/dev/null 2>&1 || true
  systemctl restart wg-quick@sockswg.service
  /usr/local/sbin/soga-warp-direct ensure
  systemctl start warp-sockswg-watchdog.timer >/dev/null 2>&1 || true
}

set_a_endpoint() {
  local endpoint=$1 temporary
  temporary=$(mktemp "$BASE_DIR/sockswg-a.endpoint.XXXXXX")
  awk -v replacement="$endpoint" '
    /^[[:space:]]*Endpoint[[:space:]]*=/ {print "Endpoint = " replacement; next}
    {print}
  ' /etc/wireguard/sockswg.conf > "$temporary"
  cat "$temporary" > /etc/wireguard/sockswg.conf
  rm -f "$temporary"
  chmod 600 /etc/wireguard/sockswg.conf
}

a_connection_count() {
  ss -Hntp state established src 172.16.0.2 2>/dev/null |
    awk '/"soga"/ {n++} END {print n+0}'
}

a_drain_complete() {
  /usr/local/sbin/soga-warp-direct drained a || return 1
  local count switched now
  count=$(a_connection_count)
  [ "$count" -eq 0 ] && return 0
  switched=$(cat "$BASE_DIR/switched-to-b-at" 2>/dev/null || printf 0)
  now=$(date +%s)
  [ "$count" -le "$DRAIN_CONNECTION_THRESHOLD" ] && \
    [ $((now - switched)) -ge "$DRAIN_MIN_SECONDS" ]
}

b_connection_count() {
  ss -Hntp state established src 10.203.2.1 2>/dev/null |
    awk '/"soga"/ {n++} END {print n+0}'
}

b_drain_complete() {
  /usr/local/sbin/soga-warp-direct drained b || return 1
  local count switched now
  count=$(b_connection_count)
  [ "$count" -eq 0 ] && return 0
  switched=$(cat "$BASE_DIR/switched-to-a-at" 2>/dev/null || printf 0)
  now=$(date +%s)
  [ "$count" -le "$DRAIN_CONNECTION_THRESHOLD" ] && \
    [ $((now - switched)) -ge "$DRAIN_MIN_SECONDS" ]
}

iptables_add_once() {
  local table=$1
  shift
  if ! iptables -t "$table" -C "$@" >/dev/null 2>&1; then
    iptables -t "$table" -A "$@"
  fi
}

prepare_b() {
  require_root
  [ -s "$PRIVATE_KEY_B" ] || die 'slot B private key is missing'
  local endpoint_b
  endpoint_b=$(cat "$ENDPOINT_B_FILE" 2>/dev/null || printf '%s' "$WARP_ENDPOINT")
  cleanup_b || true
  ip netns add "$NS_B"
  ip netns exec "$NS_B" sysctl -q -w net.ipv6.conf.all.disable_ipv6=1
  ip netns exec "$NS_B" sysctl -q -w net.ipv6.conf.default.disable_ipv6=1
  ip link add "$VETH_HOST" type veth peer name "$VETH_NS"
  ip link set "$VETH_NS" netns "$NS_B"
  ip address add "$HOST_ADDR" dev "$VETH_HOST"
  ip link set "$VETH_HOST" up

  ip -n "$NS_B" link set lo up
  ip -n "$NS_B" address add "$NS_ADDR" dev "$VETH_NS"
  ip -n "$NS_B" link set "$VETH_NS" up
  ip -n "$NS_B" route add default via "$HOST_IP" dev "$VETH_NS"

  ip netns exec "$NS_B" ip link add warp-b type wireguard
  ip netns exec "$NS_B" wg set warp-b private-key "$PRIVATE_KEY_B" \
    peer "$WARP_PEER_KEY" allowed-ips '0.0.0.0/0' \
    endpoint "$endpoint_b" persistent-keepalive 30
  ip -n "$NS_B" address add "$WARP4" dev warp-b
  ip -n "$NS_B" link set warp-b mtu 1420 up
  ip -n "$NS_B" route add default dev warp-b table "$TABLE_B"
  ip -n "$NS_B" rule add priority 10020 from "$WARP4" lookup "$TABLE_B"

  sysctl -q -w net.ipv4.ip_forward=1
  iptables_add_once nat POSTROUTING -s 10.203.2.0/30 \
    -m comment --comment sockswg-bluegreen-nat -j MASQUERADE
}

cleanup_b() {
  ip netns del "$NS_B" >/dev/null 2>&1 || true
  ip link del "$VETH_HOST" >/dev/null 2>&1 || true
}

delete_selector_rules() {
  local rule
  for rule in tcp udp; do
    while iptables -t nat -C OUTPUT -p "$rule" -d 127.0.0.1/32 \
      --dport "$FRONT_PORT" -m owner ! --uid-owner "$(id -u "$CHECK_USER")" \
      -m comment --comment "$SELECTOR_COMMENT" \
      -j DNAT --to-destination "$NS_IP:$BACKEND_B_PORT" >/dev/null 2>&1; do
      iptables -t nat -D OUTPUT -p "$rule" -d 127.0.0.1/32 \
        --dport "$FRONT_PORT" -m owner ! --uid-owner "$(id -u "$CHECK_USER")" \
        -m comment --comment "$SELECTOR_COMMENT" \
        -j DNAT --to-destination "$NS_IP:$BACKEND_B_PORT"
    done
  done
}

switch_a() {
  require_root
  /usr/local/sbin/soga-warp-direct select a
  delete_selector_rules
  printf 'a\n' > "$ACTIVE_FILE"
  date +%s > "$BASE_DIR/switched-to-a-at"
  log 'active slot is now A; direct connections on the previous slot are draining'
}

switch_b() {
  health_b >/dev/null || die "slot B did not pass direct health checks"
  require_root
  /usr/local/sbin/soga-warp-direct select b
  delete_selector_rules
  printf 'b\n' > "$ACTIVE_FILE"
  date +%s > "$BASE_DIR/switched-to-b-at"
  log 'active slot is now B; direct connections on the previous slot are draining'
}

apply_active() {
  case "$(cat "$ACTIVE_FILE" 2>/dev/null || printf a)" in
    b) switch_b ;;
    *) switch_a ;;
  esac
}

trace_via() {
  local source_ip=$1
  shift
  "$@" curl -4ksS --max-time 10 --noproxy '*' --interface "$source_ip" \
    https://www.cloudflare.com/cdn-cgi/trace
}

google_code_via() {
  local source_ip=$1
  shift
  local result code redirect
  result=$("$@" curl -4ksS -o /dev/null -w '%{http_code} %{redirect_url}' --max-time 12 \
    --noproxy '*' --interface "$source_ip" https://www.google.com/)
  code=${result%% *}
  redirect=${result#* }
  if [[ "$redirect" == *'/sorry/'* ]]; then
    printf '429\n'
  else
    printf '%s\n' "$code"
  fi
}

youtube_region_via() {
  local source_ip=$1
  shift
  "$@" curl -4ksS --compressed --max-time 18 --noproxy '*' --interface "$source_ip" \
    'https://www.youtube.com/premium?hl=en' 2>/dev/null |
    grep -oE '"GL":"[A-Z]{2}"' | head -n1 | cut -d'"' -f4
}

google_target_via() {
  local source_ip=$1
  shift
  local location
  location=$("$@" curl -4ksSI --max-time 12 --noproxy '*' --interface "$source_ip" \
    https://www.google.com/ 2>/dev/null |
    awk 'BEGIN{IGNORECASE=1} /^location:/ {gsub("\\r", ""); print $2; exit}')
  if [ -n "$location" ]; then
    sed -E 's#^[a-z]+://([^/]+).*#\1#' <<<"$location"
  else
    printf 'google.com\n'
  fi
}

classify_gemini_response() {
  local body=$1 http_code=$2 error_code
  if ! [[ "$http_code" =~ ^2[0-9][0-9]$ ]]; then
    printf 'http-%s\n' "${http_code:-unknown}"
    return 1
  fi
  if grep -q 'BardErrorInfo' "$body"; then
    error_code=$(grep -oE 'BardErrorInfo[^]]*\[([0-9]+)' "$body" 2>/dev/null |
      head -n1 | grep -oE '[0-9]+$' || true)
    printf 'bard-error-%s\n' "${error_code:-unknown}"
    return 1
  fi
  if grep -Eq 'rc_[0-9a-fA-F]{8,}' "$body"; then
    printf 'ok\n'
    return 0
  fi
  if grep -Eqi '/sorry/|too many requests|(^|[^[:alnum:]])429([^[:alnum:]]|$)' "$body"; then
    printf 'google-blocked\n'
    return 1
  fi
  printf 'invalid-response\n'
  return 1
}

gemini_probe_via() {
  local source_ip=$1
  shift
  local body http_code result probe_ok=0
  local -a runner=("$@")
  body=$("${runner[@]}" mktemp) || {
    printf 'temporary-file-error\n'
    return 1
  }
  if http_code=$("${runner[@]}" curl -4ksS --compressed \
      -A 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/139.0.0.0 Safari/537.36' \
      --max-time "$GEMINI_TIMEOUT" --connect-timeout 10 \
      --noproxy '*' --interface "$source_ip" -o "$body" -w '%{http_code}' \
      -X POST -H 'content-type: application/x-www-form-urlencoded;charset=UTF-8' \
      --data 'f.req=[]' "$GEMINI_URL" 2>/dev/null); then
    if result=$(classify_gemini_response "$body" "$http_code"); then
      probe_ok=1
    fi
  else
    result=transport-error
  fi
  rm -f "$body"
  printf '%s\n' "${result:-transport-error}"
  [ "$probe_ok" = 1 ]
}

gemini_cache_value() {
  local slot=$1 key=$2
  awk -F= -v key="$key" '$1 == key {print $2; exit}' \
    "$STATE_DIR/gemini-$slot" 2>/dev/null
}

write_gemini_cache() {
  local slot=$1 ip=$2 result=$3 temporary quality_temporary
  install -d -m 700 "$STATE_DIR"
  temporary=$(mktemp "$STATE_DIR/gemini-$slot.XXXXXX")
  cat > "$temporary" <<EOF
checked_at=$(date +%s)
ip=$ip
result=$result
EOF
  mv -f "$temporary" "$STATE_DIR/gemini-$slot"
  if [ "$result" != ok ]; then
    quality_temporary=$(mktemp "$BASE_DIR/quality-$slot.XXXXXX")
    cat > "$quality_temporary" <<EOF
tier=unusable
warp_loc=$DESIRED_LOC
google_region=unknown
google_target=gemini.google.com
gemini=$result
checked_at=$(date +%s)
EOF
    mv -f "$quality_temporary" "$BASE_DIR/quality-$slot"
  fi
}

gemini_probe_slot() {
  local slot=$1 source_ip ip result probe_ok=0
  local -a runner=()
  if [ "$slot" = a ]; then
    source_ip="172.16.0.2"
    runner=(runuser -u "$CHECK_USER" --)
    ip=$(public_ip_a || true)
  else
    source_ip="10.203.2.1"
    ip=$(public_ip_b || true)
  fi
  [ -n "$ip" ] || return 1
  if result=$(gemini_probe_via "$source_ip" "${runner[@]}"); then
    probe_ok=1
  fi
  write_gemini_cache "$slot" "$ip" "$result"
  [ "$probe_ok" = 1 ]
}

gemini_health_slot() {
  local slot=$1 ip cached_ip checked_at result now
  if [ "$slot" = a ]; then
    ip=$(public_ip_a || true)
  else
    ip=$(public_ip_b || true)
  fi
  [ -n "$ip" ] || return 1
  cached_ip=$(gemini_cache_value "$slot" ip || true)
  checked_at=$(gemini_cache_value "$slot" checked_at || true)
  result=$(gemini_cache_value "$slot" result || true)
  now=$(date +%s)
  if [ "$cached_ip" != "$ip" ] || ! [[ "$checked_at" =~ ^[0-9]+$ ]] ||
      [ $((now - ${checked_at:-0})) -ge "$GEMINI_CHECK_INTERVAL" ]; then
    gemini_probe_slot "$slot" || return 1
    result=$(gemini_cache_value "$slot" result)
  fi
  [ "$result" = ok ] || return 1
  printf 'gemini=ok\n'
}

assess_quality() {
  local slot=$1 source_ip region target tier
  local -a runner=()
  if [ "$slot" = a ]; then
    source_ip="172.16.0.2"
    runner=(runuser -u "$CHECK_USER" --)
  else
    source_ip="10.203.2.1"
  fi
  "health_$slot" >/dev/null || return 1
  region=$(youtube_region_via "$source_ip" "${runner[@]}" || true)
  target=$(google_target_via "$source_ip" "${runner[@]}" || true)
  tier=usable
  [ "$region" = "$DESIRED_LOC" ] && tier=optimal
  cat > "$BASE_DIR/quality-$slot" <<EOF
tier=$tier
warp_loc=$DESIRED_LOC
google_region=${region:-unknown}
google_target=${target:-unknown}
gemini=ok
checked_at=$(date +%s)
EOF
  printf '%s\n' "$tier"
}

health_result() {
  local source_ip=$1
  shift
  local trace warp loc code
  /usr/local/sbin/soga-warp-direct udp "$source_ip" || return 1
  trace=$(trace_via "$source_ip" "$@" 2>/dev/null) || return 1
  warp=$(awk -F= '$1 == "warp" {print $2}' <<<"$trace")
  loc=$(awk -F= '$1 == "loc" {print $2}' <<<"$trace")
  [[ "$warp" =~ ^(on|plus)$ ]] || return 1
  [ -z "$DESIRED_LOC" ] || [ "$loc" = "$DESIRED_LOC" ] || return 1
  code=$(google_code_via "$source_ip" "$@" 2>/dev/null) || return 1
  [[ "$code" =~ ^[23][0-9][0-9]$ ]] || return 1
  [ "$code" != 429 ] || return 1
  printf 'loc=%s warp=%s google=%s\n' "$loc" "$warp" "$code"
}

health_a() {
  local transport gemini
  transport=$(health_result "172.16.0.2" runuser -u "$CHECK_USER" --) || return 1
  gemini=$(gemini_health_slot a) || return 1
  printf '%s %s\n' "$transport" "$gemini"
}

health_b() {
  local transport gemini
  systemctl is-active --quiet sockswg-bluegreen-b.service || return 1
  transport=$(health_result "10.203.2.1") || return 1
  gemini=$(gemini_health_slot b) || return 1
  printf '%s %s\n' "$transport" "$gemini"
}

public_ip_a() {
  trace_via "172.16.0.2" runuser -u "$CHECK_USER" -- 2>/dev/null |
    awk -F= '$1 == "ip" {print $2; exit}'
}

public_ip_b() {
  trace_via "10.203.2.1" 2>/dev/null |
    awk -F= '$1 == "ip" {print $2; exit}'
}

validate_candidate() {
  local slot=$1 forbidden_ip=${2:-} other_ip candidate_ip i
  for i in 1 2 3; do
    "health_$slot" >/dev/null || return 1
    [ "$i" = 3 ] || sleep 2
  done
  candidate_ip=$("public_ip_$slot")
  if [ "$slot" = a ]; then
    other_ip=$(public_ip_b)
  else
    other_ip=$(public_ip_a)
  fi
  [ -n "$candidate_ip" ] || return 1
  [ "$candidate_ip" != "$other_ip" ] || {
    log "candidate $slot was rejected because both slots use $candidate_ip"
    return 1
  }
  [ -z "$forbidden_ip" ] || [ "$candidate_ip" != "$forbidden_ip" ] || {
    log "candidate $slot was rejected because its public IP did not change: $candidate_ip"
    return 1
  }
  assess_quality "$slot" >/dev/null || return 1
  printf '%s\n' "$candidate_ip"
}

restart_b() {
  b_drain_complete || { log 'B still draining; defer namespace rebuild'; return 1; }
  systemctl stop sockswg-bluegreen-b.service
  cleanup_b
  systemctl start sockswg-bluegreen-b.service
}

refresh_b_once() {
  /usr/local/sbin/soga-warp-direct drained b || { log "direct B connections are still draining; defer repair"; return 1; }
  require_root
  [ "$(cat "$ACTIVE_FILE" 2>/dev/null || printf a)" = a ] || \
    die 'refusing to rebuild B while B is active'
  local candidate previous candidate_ip previous_ip
  previous_ip=$(public_ip_b || true)
  candidate=$(mktemp "$BASE_DIR/account-b.candidate.XXXXXX")
  previous=$(mktemp "$BASE_DIR/account-b.previous.XXXXXX")
  chmod 600 "$candidate" "$previous"
  cp -f "$ACCOUNT_B" "$previous"
  log 'registering a new peer for inactive slot B'
  if ! register_account "$candidate"; then
    rm -f "$candidate" "$previous"
    return 1
  fi
  cp -f "$candidate" "$ACCOUNT_B"
  write_b_config "$ACCOUNT_B"
  restart_b
  if candidate_ip=$(validate_candidate b "$previous_ip"); then
    cancel_account "$previous"
    rm -f "$candidate" "$previous"
    log "inactive slot B accepted a new qualified WARP IP: $candidate_ip"
    return 0
  fi
  log 'new B peer failed qualification; restoring the previous slot B peer'
  cancel_account "$ACCOUNT_B"
  cp -f "$previous" "$ACCOUNT_B"
  write_b_config "$ACCOUNT_B"
  restart_b
  rm -f "$candidate" "$previous"
  health_b >/dev/null || die 'the previous B peer did not recover after candidate rollback'
  return 1
}

refresh_b() {
  local attempts=${1:-3} i
  [[ "$attempts" =~ ^[1-9]$|^10$ ]] || die 'refresh-b attempts must be between 1 and 10'
  for ((i=1; i<=attempts; i++)); do
    refresh_b_once && return 0
    [ "$i" = "$attempts" ] || sleep 10
  done
  log "no qualified B peer was found after $attempts attempts"
  return 1
}

reroll_b() {
  /usr/local/sbin/soga-warp-direct drained b || { log "direct B connections are still draining; defer repair"; return 1; }
  local attempts=${1:-6} rejected_ip candidate_ip i endpoint
  [ "$(cat "$ACTIVE_FILE" 2>/dev/null || printf a)" = a ] || \
    die 'refusing to reroll B while B is active'
  rejected_ip=$(public_ip_b || true)
  i=0
  for endpoint in $ENDPOINT_CANDIDATES; do
    i=$((i + 1))
    [ "$i" -le "$attempts" ] || break
    printf '%s\n' "$endpoint" > "$ENDPOINT_B_FILE"
    log "rerolling inactive B via $endpoint ($i/$attempts)"
    restart_b
    sleep 3
    if candidate_ip=$(validate_candidate b "$rejected_ip"); then
      log "inactive B accepted rerolled WARP IP: $candidate_ip"
      return 0
    fi
  done
  printf '%s\n' "$WARP_ENDPOINT" > "$ENDPOINT_B_FILE"
  restart_b
  return 1
}

repair_b() {
  reroll_b 6 && return 0
  log 'existing B peer did not produce a qualified IP; registering a replacement peer'
  refresh_b 3
}

refresh_a_once() {
  require_root
  [ "$(cat "$ACTIVE_FILE" 2>/dev/null || printf a)" = b ] || \
    die 'refusing to rebuild A while A is active'
  a_drain_complete || \
    die 'refusing to rebuild A while established A connections are still draining'
  local candidate previous_config previous_account candidate_ip previous_ip
  previous_ip=$(public_ip_a || true)
  candidate=$(mktemp "$BASE_DIR/account-a.candidate.XXXXXX")
  previous_config=$(mktemp "$BASE_DIR/sockswg-a.previous.XXXXXX")
  chmod 600 "$candidate" "$previous_config"
  cp -f /etc/wireguard/sockswg.conf "$previous_config"
  previous_account=
  if [ -s "$ACCOUNT_A" ]; then
    previous_account=$(mktemp "$BASE_DIR/account-a.previous.XXXXXX")
    chmod 600 "$previous_account"
    cp -f "$ACCOUNT_A" "$previous_account"
  fi
  log 'registering a new peer for drained inactive slot A'
  if ! register_account "$candidate"; then
    rm -f "$candidate" "$previous_config"
    [ -z "$previous_account" ] || rm -f "$previous_account"
    return 1
  fi
  write_a_config "$candidate"
  restart_a
  if candidate_ip=$(validate_candidate a "$previous_ip"); then
    [ -z "$previous_account" ] || cancel_account "$previous_account"
    cp -f "$candidate" "$ACCOUNT_A"
    rm -f "$candidate" "$previous_config"
    [ -z "$previous_account" ] || rm -f "$previous_account"
    log "inactive slot A accepted a new qualified WARP IP: $candidate_ip"
    return 0
  fi
  log 'new A peer failed qualification; restoring the previous slot A peer'
  cancel_account "$candidate"
  cp -f "$previous_config" /etc/wireguard/sockswg.conf
  chmod 600 /etc/wireguard/sockswg.conf
  restart_a
  rm -f "$candidate" "$previous_config"
  [ -z "$previous_account" ] || rm -f "$previous_account"
  return 1
}

refresh_a() {
  local attempts=${1:-3} i
  [[ "$attempts" =~ ^[1-9]$|^10$ ]] || die 'refresh-a attempts must be between 1 and 10'
  for ((i=1; i<=attempts; i++)); do
    refresh_a_once && return 0
    [ "$i" = "$attempts" ] || sleep 10
  done
  log "no qualified A peer was found after $attempts attempts"
  return 1
}

reroll_a() {
  local attempts=${1:-6} rejected_ip candidate_ip i endpoint
  [ "$(cat "$ACTIVE_FILE" 2>/dev/null || printf a)" = b ] || \
    die 'refusing to reroll A while A is active'
  a_drain_complete || \
    die 'refusing to reroll A while established A connections are still draining'
  rejected_ip=$(public_ip_a || true)
  i=0
  for endpoint in $ENDPOINT_CANDIDATES; do
    i=$((i + 1))
    [ "$i" -le "$attempts" ] || break
    set_a_endpoint "$endpoint"
    log "rerolling drained inactive A via $endpoint ($i/$attempts)"
    restart_a
    sleep 3
    if candidate_ip=$(validate_candidate a "$rejected_ip"); then
      log "inactive A accepted rerolled WARP IP: $candidate_ip"
      return 0
    fi
  done
  set_a_endpoint "$WARP_ENDPOINT"
  restart_a
  return 1
}

repair_a() {
  reroll_a 6 && return 0
  log 'existing A peer did not produce a qualified IP; registering a replacement peer'
  refresh_a 3
}

counter_get() {
  cat "$STATE_DIR/$1" 2>/dev/null || printf 0
}

counter_set() {
  printf '%s\n' "$2" > "$STATE_DIR/$1"
}

rotation_due() {
  local slot=$1 now last
  now=$(date +%s)
  last=$(counter_get "last_rotate_$slot")
  [ $((now - last)) -ge "$ROTATE_INTERVAL" ]
}

mark_rotation() {
  counter_set "last_rotate_$1" "$(date +%s)"
}

check() {
  require_root
  install -d -m 700 "$STATE_DIR"
  exec 9>"$STATE_DIR/lock"
  flock -n 9 || exit 0
  local active a_ok=0 b_ok=0 b_candidate_ok=0 a_candidate_ok=0 failures a_ip b_ip
  active=$(cat "$ACTIVE_FILE" 2>/dev/null || printf a)
  health_a >/dev/null && a_ok=1 || true
  health_b >/dev/null && b_ok=1 || true
  [ "$a_ok" = 1 ] && a_ip=$(public_ip_a || true) || a_ip=
  [ "$b_ok" = 1 ] && b_ip=$(public_ip_b || true) || b_ip=
  # Automatic repair is health-driven only. Egress diversity and an optimal
  # Google region are reported for manual optimization, but never justify
  # rebuilding an otherwise healthy inactive slot.
  [ "$b_ok" = 1 ] && b_candidate_ok=1 || true
  [ "$a_ok" = 1 ] && a_candidate_ok=1 || true

  if [ "$active" = a ]; then
    if [ "$b_candidate_ok" = 1 ]; then
      counter_set b_candidate_fail 0
    else
      failures=$(counter_get b_candidate_fail)
      if [ "$failures" -lt "$CANDIDATE_FAIL_THRESHOLD" ]; then
        failures=$((failures + 1))
        counter_set b_candidate_fail "$failures"
        log "inactive B candidate failed qualification ($failures/$CANDIDATE_FAIL_THRESHOLD)"
      fi
      if [ "$failures" -ge "$CANDIDATE_FAIL_THRESHOLD" ] && rotation_due b; then
        mark_rotation b
        if repair_b; then
          b_ok=1
          b_candidate_ok=1
          counter_set b_candidate_fail 0
        fi
      fi
    fi
    if [ "$a_ok" = 1 ]; then
      counter_set a_fail 0
      if [ "$b_ok" = 1 ] && b_drain_complete && rotation_due b; then
        mark_rotation b
        if [ "$(assess_quality b 2>/dev/null || printf unavailable)" != optimal ]; then
          log 'inactive B is healthy but not optimal; starting the hourly IP selection round'
          repair_b || log 'inactive B did not find a better qualified IP in this hourly round'
        fi
      fi
      exit 0
    fi
    failures=$(counter_get a_fail)
    if [ "$failures" -lt "$FAIL_THRESHOLD" ]; then
      failures=$((failures + 1))
      counter_set a_fail "$failures"
      log "active A health check failed ($failures/$FAIL_THRESHOLD)"
    fi
    if [ "$failures" -ge "$FAIL_THRESHOLD" ] && [ "$b_ok" = 1 ]; then
      switch_b
      counter_set a_fail 0
      counter_set a_recover 0
    fi
  else
    if [ "$a_candidate_ok" != 1 ] && a_drain_complete && rotation_due a; then
      mark_rotation a
      if repair_a; then
        a_ok=1
        a_candidate_ok=1
      fi
    fi
    if [ "$b_ok" != 1 ]; then
      failures=$(counter_get b_fail)
      if [ "$failures" -lt "$FAIL_THRESHOLD" ]; then
        failures=$((failures + 1))
        counter_set b_fail "$failures"
        log "active B health check failed ($failures/$FAIL_THRESHOLD)"
      fi
      if [ "$failures" -ge "$FAIL_THRESHOLD" ] && [ "$a_ok" = 1 ]; then
        switch_a
        counter_set b_fail 0
      fi
      exit 0
    fi
    counter_set b_fail 0
    if [ "$a_ok" = 1 ] && a_drain_complete && rotation_due a; then
      mark_rotation a
      if [ "$(assess_quality a 2>/dev/null || printf unavailable)" != optimal ]; then
        log 'inactive A is healthy but not optimal; starting the hourly IP selection round'
        repair_a || log 'inactive A did not find a better qualified IP in this hourly round'
      fi
    fi
    # A and B are peers. Keep a healthy active B indefinitely; a recovered A
    # stays idle and is used only if B later fails.
    counter_set a_recover 0
  fi
}

show_test() {
  local name=$1 result
  if result=$("health_$name"); then
    printf '%s healthy %s\n' "${name^^}" "$result"
  else
    printf '%s unhealthy\n' "${name^^}"
    return 1
  fi
}

status() {
  local a_ip b_ip diverse=no
  a_ip=$(public_ip_a 2>/dev/null || true)
  b_ip=$(public_ip_b 2>/dev/null || true)
  [ -n "$a_ip" ] && [ -n "$b_ip" ] && [ "$a_ip" != "$b_ip" ] && diverse=yes
  printf 'active=%s b_service=%s selector_rules=%s draining_a_connections=%s\n' \
    "$(cat "$ACTIVE_FILE" 2>/dev/null || printf a)" \
    "$(systemctl is-active sockswg-bluegreen-b.service 2>/dev/null || true)" \
    "$(iptables -t nat -S OUTPUT | grep -c -- "$SELECTOR_COMMENT" || true)" \
    "$(a_connection_count)"
  printf 'a_ip=%s b_ip=%s diverse=%s\n' "${a_ip:-unavailable}" "${b_ip:-unavailable}" "$diverse"
  [ -s "$BASE_DIR/quality-a" ] && printf 'A_quality %s\n' "$(tr '\n' ' ' < "$BASE_DIR/quality-a")"
  [ -s "$BASE_DIR/quality-b" ] && printf 'B_quality %s\n' "$(tr '\n' ' ' < "$BASE_DIR/quality-b")"
  [ -s "$STATE_DIR/gemini-a" ] && printf 'A_gemini %s\n' "$(tr '\n' ' ' < "$STATE_DIR/gemini-a")"
  [ -s "$STATE_DIR/gemini-b" ] && printf 'B_gemini %s\n' "$(tr '\n' ' ' < "$STATE_DIR/gemini-b")"
  show_test a || true
  show_test b || true
}

write_units() {
  die 'legacy SOCKS installer disabled on this direct-WARP pilot; use the managed direct service'
}

ensure_settings() {
  [ -s "$SETTINGS_FILE" ] && return 0
  local trace detected_loc
  trace=$(trace_via "127.0.0.1:$FRONT_PORT" runuser -u "$CHECK_USER" -- 2>/dev/null) || \
    die 'could not detect the initial slot A location'
  detected_loc=$(awk -F= '$1 == "loc" {print $2; exit}' <<<"$trace")
  [[ "$detected_loc" =~ ^[A-Z]{2}$ ]] || die 'initial slot A returned an invalid location code'
  DESIRED_LOC=$detected_loc
  cat > "$SETTINGS_FILE" <<EOF
# Auto-detected from the existing slot A path during installation.
DESIRED_LOC=$DESIRED_LOC
FAIL_THRESHOLD=$FAIL_THRESHOLD
ROTATE_INTERVAL=$ROTATE_INTERVAL
CANDIDATE_FAIL_THRESHOLD=$CANDIDATE_FAIL_THRESHOLD
DRAIN_MIN_SECONDS=$DRAIN_MIN_SECONDS
DRAIN_CONNECTION_THRESHOLD=$DRAIN_CONNECTION_THRESHOLD
GEMINI_CHECK_INTERVAL=$GEMINI_CHECK_INTERVAL
GEMINI_TIMEOUT=$GEMINI_TIMEOUT
EOF
  chmod 644 "$SETTINGS_FILE"
  log "using auto-detected desired WARP location: $DESIRED_LOC"
}

install_all() {
  die 'legacy SOCKS installer disabled on this direct-WARP pilot; use the managed direct service'
}

case "${1:-}" in
  install) install_all ;;
  prepare-b) prepare_b ;;
  cleanup-b) cleanup_b ;;
  switch-a) switch_a ;;
  switch-b) switch_b ;;
  apply-active) apply_active ;;
  check) check ;;
  refresh-a) refresh_a "${2:-3}" ;;
  refresh-b) refresh_b "${2:-3}" ;;
  repair-a) repair_a ;;
  repair-b) repair_b ;;
  ipv4-only-a) normalize_a_ipv4_only ;;
  assess-a) assess_quality a ;;
  assess-b) assess_quality b ;;
  test-a) show_test a ;;
  test-b) show_test b ;;
  status) status ;;
  *) die 'usage: sockswg-bluegreen {install|prepare-b|cleanup-b|switch-a|switch-b|apply-active|check|repair-a|repair-b|ipv4-only-a|refresh-a [attempts]|refresh-b [attempts]|assess-a|assess-b|test-a|test-b|status}' ;;
esac
